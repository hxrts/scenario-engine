-- | The capstone's joint pass against its recording (docs/08_coverage.md). `capstone/transcript.json`
-- | is generated by `just _scenarios` (`apps/cli`, module `Transcript`) from the DSL's exchanges; this
-- | suite reads it through the replay port, so no model and no prompt text are involved. Every line
-- | maps to the Intents the DSL expects. The capstone's round trip through the Run Store is in
-- | `Test.Adapters.Capstone`; the prompts and the wire decoding are in `Test.Adapters.Llm`.
module Test.Handlers.Capstone (spec) where

import Prelude

import Adapters.Recording (Recording, decodeRecording, replayPort)
import Adapters.Scenarios (readScenario, readText)
import Board.Gameboard.Instantiate (instantiate)
import Control.Monad.Error.Class (throwError)
import Core.Types (Entity, EntityId, Id(..))
import Core.World (WorldState)
import Data.Argonaut.Core (stringify)
import Data.Argonaut.Encode (encodeJson)
import Data.Array (length)
import Data.Either (Either(..), either)
import Data.Foldable (for_)
import Data.Map as Map
import Data.Maybe (Maybe)
import Data.String (Pattern(..), contains)
import Effect.Aff (Aff, attempt)
import Effect.Class (liftEffect)
import Effect.Exception (error, message)
import Effects.Signatures (InterpretF(..), JointProposal)
import Handlers.Llm (ModelPort, interpreter)
import Scenarios.Capstone (JointLine, jointLines)
import Scenarios.Load (load)
import Test.Spec (Spec, describe, it)
import Test.Spec.Assertions (fail, shouldEqual)

orThrow :: forall a. Either String a -> Aff a
orThrow = either (throwError <<< error) pure

-- | `packages/scenarios/capstone/transcript.json`, decoded to its recording.
recording :: Aff Recording
recording = liftEffect (readText "capstone/transcript.json") >>= orThrow >>= orThrow <<< decodeRecording

type Game = { world :: WorldState, lookup :: EntityId -> Maybe Entity }

setup :: Aff Game
setup = do
  loaded <- liftEffect (readScenario "meridian/v0") >>= orThrow >>= (orThrow <<< load)
  case instantiate loaded.gameboard loaded.config of
    Right initial -> pure { world: initial.world, lookup: \e -> Map.lookup e initial.world.entities }
    Left _ -> throwError (error "instantiation")

-- | One joint pass over a single transcript from the US seat.
jointAs :: Game -> String -> ModelPort -> Aff (Either String (Array JointProposal))
jointAs g text backend =
  interpreter backend g.world (Interpret 1 [ { seat: Id "US", text } ] identity)

-- | Every recorded line gives the joint pass the Intents the DSL expects, in the engine's JSON encoding.
check :: JointLine -> Array JointProposal -> Aff Unit
check e out = map (\j -> stringify (encodeJson j.draft.intents)) out `shouldEqual` [ stringify (encodeJson e.expect) ]

spec :: Spec Unit
spec = describe "Capstone: recorded transcript through the joint pass" do
  it "each recorded line maps to the canonical Intents it records (replayed)" do
    g <- setup
    rec <- recording
    for_ jointLines \e -> do
      out <- jointAs g e.text (replayPort rec)
      case out of
        Right js -> check e js
        Left why -> fail ("the recorded reply should decode: " <> why)

  it "the recorded line for a trade interprets to one Proposal" do
    g <- setup
    rec <- recording
    ok <- jointAs g "buy ten energy" (replayPort rec)
    case ok of
      Right js | length js == 1 -> pure unit
      _ -> fail "replayed line should interpret"

  it "a recorded backend failure is a run failure, naming the model and its cause" do
    g <- setup
    rec <- recording
    let
      broken :: ModelPort
      broken =
        { model: "recorded"
        , interpret: \_ -> throwError (error "language model backend failed (recorded): spawn pi ENOENT")
        , narrate: \_ -> pure (Right "")
        , speak: \_ -> pure (Right "")
        }
    out <- attempt (jointAs g "buy ten energy" broken)
    case out of
      Left e -> (contains (Pattern "language model backend failed") (message e)) `shouldEqual` true
      Right _ -> fail "a failed backend must fail the call"
    -- the same line, replayed, still interprets: the failure was the backend's, not the transcript's
    ok <- jointAs g "buy ten energy" (replayPort rec)
    case ok of
      Right _ -> pure unit
      Left _ -> fail "replayed line should interpret"

  it "a transcript the recording does not hold is an error, never a model call" do
    g <- setup
    rec <- recording
    out <- attempt (jointAs g "buy some energy" (replayPort rec))
    case out of
      Left e -> (contains (Pattern "no recorded interpret call") (message e)) `shouldEqual` true
      Right _ -> fail "an unrecorded request must not be answered"
