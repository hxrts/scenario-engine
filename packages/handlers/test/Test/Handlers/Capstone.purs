-- | The capstone's joint pass against its recording. `capstone/transcript.json`
-- | is generated by `just _premises` (`apps/cli`, module `Transcript`) from the DSL's exchanges; this
-- | suite replays it through a stub backend that answers each request from the recording, so no model
-- | is called and the prompts and decoding of `Handlers.Llm` run as they do in production. The capstone's
-- | round trip through the Run Store is in `Test.Adapters.Capstone`; the prompts are in `Test.Handlers.Llm`.
module Test.Handlers.Capstone (spec) where

import Prelude

import Adapters.Filesystem (fileOps)
import Premises.Tree (readRootFile)
import Test.Handlers.Run (meridian)
import Game.Types (Game)
import Control.Monad.Error.Class (throwError)
import Core.Proposal (JointProposal)
import Core.Types (Id(..))
import Data.Argonaut.Core (stringify)
import Data.Argonaut.Encode (encodeJson)
import Data.Array (length)
import Data.Either (Either(..))
import Data.Foldable (for_)
import Data.String (Pattern(..), contains)
import Effect.Aff (Aff, attempt)
import Effect.Class (liftEffect)
import Effect.Exception (error, message)
import Effects.Signatures (InterpretF(..))
import Handlers.Llm (Backend, interpreter)
import Handlers.Recording (Recording)
import Premises.Capstone (JointLine, jointLines)
import Test.Handlers.Stub (backendOf, decodeRecording, replayCall)
import Testkit.Meridian (orThrow)
import Test.Spec (Spec, describe, it)
import Test.Spec.Assertions (fail, shouldEqual)

-- | `packages/premises/capstone/transcript.json`, decoded to its recording.
recording :: Aff Recording
recording = liftEffect (readRootFile fileOps "capstone/transcript.json") >>= orThrow >>= orThrow <<< decodeRecording

setup :: Aff Game
setup = meridian

-- | One joint pass over a single transcript from the US seat.
jointAs :: Game -> String -> Backend -> Aff (Either String (Array JointProposal))
jointAs g text backend =
  interpreter backend g.world (Interpret 1 [ { seat: Id "US", text } ] identity)

-- | Every recorded line gives the joint pass the Intents the DSL expects, in the engine's JSON encoding.
check :: JointLine -> Array JointProposal -> Aff Unit
check e out = map (\j -> stringify (encodeJson j.draft.intents)) out `shouldEqual` [ stringify (encodeJson e.expect) ]

spec :: Spec Unit
spec = describe "Capstone: recorded transcript through the joint pass" do
  it "each recorded line, in its recorded order, maps to the canonical Intents it records (replayed)" do
    g <- setup
    rec <- recording
    replay <- liftEffect (replayCall rec)
    for_ jointLines \e -> do
      out <- jointAs g e.text (backendOf replay)
      case out of
        Right js -> check e js
        Left why -> fail ("the recorded reply should decode: " <> why)

  it "the recorded trade line interprets to one Proposal, once the line before it is replayed" do
    g <- setup
    rec <- recording
    replay <- liftEffect (replayCall rec)
    _ <- jointAs g "ban shipments into India" (backendOf replay)
    ok <- jointAs g "buy ten energy" (backendOf replay)
    case ok of
      Right js | length js == 1 -> pure unit
      _ -> fail "replayed line should interpret"

  it "a recorded backend failure is a run failure, naming the model and its cause" do
    g <- setup
    rec <- recording
    let
      broken :: Backend
      broken = backendOf (\_ _ -> throwError (error "language model backend failed (recorded): spawn pi ENOENT"))
    out <- attempt (jointAs g "buy ten energy" broken)
    case out of
      Left e -> (contains (Pattern "language model backend failed") (message e)) `shouldEqual` true
      Right _ -> fail "a failed backend must fail the call"
    -- the same call, replayed from the start, still interprets: the failure was the backend's, not the recording's
    replay <- liftEffect (replayCall rec)
    ok <- jointAs g "ban shipments into India" (backendOf replay)
    case ok of
      Right _ -> pure unit
      Left _ -> fail "replayed line should interpret"

  it "a call the recording does not hold in its next place is an error, never a model call" do
    g <- setup
    rec <- recording
    replay <- liftEffect (replayCall rec)
    out <- attempt (interpreter (backendOf replay) g.world (Interpret 2 [ { seat: Id "US", text: "buy ten energy" } ] identity))
    case out of
      Left e -> (contains (Pattern "no recorded call matches this request") (message e)) `shouldEqual` true
      Right _ -> fail "an unrecorded round must not be answered"
    -- a spent recording answers nothing either
    for_ jointLines \e -> jointAs g e.text (backendOf replay)
    spent <- attempt (jointAs g "buy ten energy" (backendOf replay))
    case spent of
      Left e -> (contains (Pattern "no recorded call matches this request") (message e)) `shouldEqual` true
      Right _ -> fail "a spent recording must not answer"
