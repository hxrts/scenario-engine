#!/usr/bin/env node
// Fails if a workspace package depends outside its allowed set (docs/07_architecture.md §3)
// or if a pure package depends on an effectful library.
const fs = require("fs");
const path = require("path");

const allowed = {
  core: [],
  board: ["core"],
  policy: ["core"],
  scenarios: ["core", "board", "policy"],
  effects: ["core", "board", "policy"],
  handlers: ["core", "board", "policy", "effects"],
  adapters: ["core", "board", "policy", "effects", "handlers"],
  simulator: ["core", "board", "policy", "effects", "handlers"],
  analysis: ["core", "board", "simulator"],
  // test support only (the shared fixtures of the analysis and simulator suites); no suite's source imports it
  testkit: ["core", "board", "policy", "scenarios", "adapters", "simulator"],
  cli: null, server: null, dashboard: null, // apps may depend on anything
};
// workspace dependencies a package's test suite may not take, beyond its `allowed` set
const testForbidden = { simulator: ["analysis"] };
const pure = ["core", "board", "policy"];
const impure = (d) => ["effect", "aff", "run"].includes(d) || d.startsWith("node-");

const root = path.join(__dirname, "..");
const dirs = ["packages", "apps"].flatMap((d) =>
  fs.readdirSync(path.join(root, d)).map((n) => path.join(root, d, n)));

let errors = [];
for (const dir of dirs) {
  const file = path.join(dir, "spago.yaml");
  if (!fs.existsSync(file)) continue;
  const text = fs.readFileSync(file, "utf8");
  const name = text.match(/name:\s*sp-(\S+)/)[1];
  // the `test:` section is checked too: a test suite may not add a workspace edge the table forbids
  const [srcPart, testPart = ""] = text.split(/\n\s*test:/);
  const deps = [...srcPart.matchAll(/^\s+- (\S+)/gm)].map((m) => m[1]);
  const testDeps = [...testPart.matchAll(/^\s+- (\S+)/gm)].map((m) => m[1]);
  if (!(name in allowed)) { errors.push(`${name}: not in the allowed-dependency table`); continue; }
  for (const d of deps) {
    if (d.startsWith("sp-")) {
      const dep = d.slice(3);
      if (allowed[name] && !allowed[name].includes(dep)) errors.push(`${name} -> ${dep} is not allowed`);
    } else if (pure.includes(name) && impure(d)) {
      errors.push(`${name} is pure but depends on ${d}`);
    }
  }
  // the simulator's test suite may not reach analysis either (docs/06 §14, docs/07 §3)
  for (const d of testDeps) {
    if (name in testForbidden && testForbidden[name].includes(d.replace(/^sp-/, ""))) errors.push(`${name} (test) -> ${d} is not allowed`);
  }
}
if (errors.length) { console.error(errors.join("\n")); process.exit(1); }
console.log("dependency direction ok");
